# Supabase — client (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server only (NEVER import in client components)
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — server only
ANTHROPIC_API_KEY=

# White-label routing
# Production: revvue.live
# Local dev: leave as revvue.live and use lvh.me for subdomain testing
#   e.g. http://acme.lvh.me:3000/dashboard
NEXT_PUBLIC_BASE_DOMAIN=revvue.live
NEXT_PUBLIC_APP_URL=https://revvue.live

# Email (Resend) — optional. If RESEND_API_KEY is empty, welcome emails
# are no-ops (logged to console). Failures NEVER block signup.
RESEND_API_KEY=
EMAIL_FROM="Revvue <noreply@revvue.live>"

# Founder contact — used in trial-expired and "email Ven to upgrade" CTAs.
NEXT_PUBLIC_FOUNDER_EMAIL=ven@revvue.live
